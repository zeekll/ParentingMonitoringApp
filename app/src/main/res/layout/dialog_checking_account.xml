<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:paddingStart="36dp"
    android:paddingEnd="36dp"
    android:paddingTop="28dp"
    android:paddingBottom="28dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_logo_circle"
        android:padding="14dp"
        android:src="@drawable/ic_lock"
        android:tint="@color/white"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Checking your account..."
        android:textColor="@color/ink"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCheckCredentials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="○  Verify credentials"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCheckUserData"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="○  Get user data"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvCheckRole"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="○  Check role"
            android:textColor="@color/ink_soft"
            android:textSize="14sp" />

    </LinearLayout>

</LinearLayout>